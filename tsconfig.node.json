{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"target": "es2023",
		"lib": ["ES2023"],
		"module": "esnext",
		"types": ["node"],
		"skipLibCheck": true,

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,

		/* Linting */
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true,
		"ignoreDeprecations": "6.0",

		/* Path aliases — espelha tsconfig.app.json para scripts poderem usar @/ */
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		}
	},
  "include": ["vite.config.ts", "src/vite-env.d.ts", "src/data/scripts/*.ts"]
}
