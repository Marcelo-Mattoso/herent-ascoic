{
	"name": "ascensao-heroica",
	"private": true,
	"version": "0.9.132",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"verify:build": "node scripts/verify-pages-build.mjs",
