	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.12.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/coverage-v8": "^4.1.11",
		"@vitest/ui": "^4.1.6",
		"eslint": "^10.3.0",
